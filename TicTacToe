    public static int getSmartCpuMove(char[][] gameBoard) {
        List topRow = Arrays.asList(1, 2, 3, 4, 5);
        List row2 = Arrays.asList(6, 7, 8, 9, 10);
        List midRow = Arrays.asList(11, 12, 13, 14, 15);
        List row4 = Arrays.asList(16, 17, 18, 19, 20);
        List botRow = Arrays.asList(21, 22, 23, 24, 25);
        
        List col1 = Arrays.asList(1, 6, 11, 16, 21);
        List col2 = Arrays.asList(2, 7, 12, 17, 22);
        List col3 = Arrays.asList(3, 8, 13, 18, 23);
        List col4 = Arrays.asList(4, 9, 14, 19, 24);
        List col5 = Arrays.asList(5, 10, 15, 20, 25);
        
        List cross1 = Arrays.asList(1, 7, 13, 19, 25);
        List cross2 = Arrays.asList(5, 9, 13, 17, 21);
        
        List<List> winning = new ArrayList<List>();
        winning.add(topRow);
        winning.add(row2);
        winning.add(midRow);
        winning.add(row4);
        winning.add(botRow);
        winning.add(col1);
        winning.add(col2);
        winning.add(col3);
        winning.add(col4);
        winning.add(col5);
        winning.add(cross1);
        winning.add(cross2);

        for (List line : winning) {
            int cpuCount = 0;
            int emptyPos = -1;
            for (Object item : line) {
                int pos = (int) item;
                if (cpuPositions.contains(pos)) {
                    cpuCount++;
                } else if (!isPositionTaken(gameBoard, pos)) {
                    emptyPos = pos;
                }
            }
            if (cpuCount == 4 && emptyPos != -1) {
                return emptyPos;
            }
        }

        for (List line : winning) {
            int playerCount = 0;
            int emptyPos = -1;
            for (Object item : line) {
                int pos = (int) item;
                if (playerPositions.contains(pos)) {
                    playerCount++;
                } else if (!isPositionTaken(gameBoard, pos)) {
                    emptyPos = pos;
                }
            }
            if (playerCount == 4 && emptyPos != -1) {
                return emptyPos;
            }
        }

        Random rand = new Random();
        int cpuPos = rand.nextInt(25) + 1;
        while (isPositionTaken(gameBoard, cpuPos)) {
            cpuPos = rand.nextInt(25) + 1;
        }
        return cpuPos;
    }

    public static void printGameBoard(char[][] gameBoard) {
        for(char[] row : gameBoard) {
            for(char c : row) {
                System.out.print(c);
            }
            System.out.println();
        }
    }

    public static boolean isPositionTaken(char[][] gameBoard, int pos) {
        switch(pos) {
            case 1: 
            	return gameBoard[0][0] != ' ';
            case 2: 
            	return gameBoard[0][2] != ' ';
            case 3:  
            	return gameBoard[0][4] != ' ';
            case 4: 
            	return gameBoard[0][6] != ' ';
            case 5:  
            	return gameBoard[0][8] != ' ';
            case 6:  
            	return gameBoard[2][0] != ' ';
            case 7:  
            	return gameBoard[2][2] != ' ';
            case 8: 
            	return gameBoard[2][4] != ' ';
            case 9: 
            	return gameBoard[2][6] != ' ';
            case 10:
            	return gameBoard[2][8] != ' ';
            case 11:
            	return gameBoard[4][0] != ' ';
            case 12:
            	return gameBoard[4][2] != ' ';
            case 13:
            	return gameBoard[4][4] != ' ';
            case 14:
            	return gameBoard[4][6] != ' ';
            case 15:
            	return gameBoard[4][8] != ' ';
            case 16: 
            	return gameBoard[6][0] != ' ';
            case 17:
            	return gameBoard[6][2] != ' ';
            case 18:
            	return gameBoard[6][4] != ' ';
            case 19: 
            	return gameBoard[6][6] != ' ';
            case 20:
            	return gameBoard[6][8] != ' ';
            case 21:
            	return gameBoard[8][0] != ' ';
            case 22: 
            	return gameBoard[8][2] != ' ';
            case 23:
            	return gameBoard[8][4] != ' ';
            case 24:
            	return gameBoard[8][6] != ' ';
            case 25:
            	return gameBoard[8][8] != ' ';
            default:return false;
        }
    }

    public static void placePiece(char[][] gameBoard, int pos, String user) {
        char symbol = ' ';
        if(user.equals("player")) {
            symbol = 'X';
        } else if(user.equals("cpu")) {
            symbol = 'O';
        }
        
        switch(pos) {
            case 1:
                gameBoard[0][0] = symbol;
                break;
            case 2:
                gameBoard[0][2] = symbol;
                break;
            case 3:
                gameBoard[0][4] = symbol;
                break;
            case 4:
                gameBoard[0][6] = symbol; 
                break;
            case 5:
                gameBoard[0][8] = symbol;
                break;

            case 6:
                gameBoard[2][0] = symbol; 
                break;
            case 7:
                gameBoard[2][2] = symbol; 
                break;
            case 8:
                gameBoard[2][4] = symbol;
                break;
            case 9:
                gameBoard[2][6] = symbol; 
                break;
            case 10:
                gameBoard[2][8] = symbol; 
                break;

            case 11: 
                gameBoard[4][0] = symbol;
                break;
            case 12:
                gameBoard[4][2] = symbol;
                break;
            case 13:
                gameBoard[4][4] = symbol;
                break;
            case 14:
                gameBoard[4][6] = symbol;
                break;
            case 15: 
                gameBoard[4][8] = symbol;
                break;

            case 16:
                gameBoard[6][0] = symbol;
                break;
            case 17:
                gameBoard[6][2] = symbol; 
                break;
            case 18:
                gameBoard[6][4] = symbol;
                break;
            case 19: 
                gameBoard[6][6] = symbol;
                break;
            case 20: 
                gameBoard[6][8] = symbol; 
                break;

            case 21:
                gameBoard[8][0] = symbol; 
                break;
            case 22: 
                gameBoard[8][2] = symbol;
                break;
            case 23: 
                gameBoard[8][4] = symbol; 
                break;
            case 24:
                gameBoard[8][6] = symbol;
                break;
            case 25:
                gameBoard[8][8] = symbol; 
                break;
            default:
                System.out.println("Please enter from 1 to 25!");
                break;
        }
    }

    public static String checkWinner() {
    	
    	List topRow = Arrays.asList(1, 2, 3, 4, 5);
    	List row2 = Arrays.asList(6, 7, 8, 9, 10);
    	List midRow = Arrays.asList(11, 12, 13, 14, 15);
    	List row4 = Arrays.asList(16, 17, 18, 19, 20);
    	List botRow = Arrays.asList(21, 22, 23, 24, 25);
    	
    	List col1 = Arrays.asList(1, 6, 11, 16, 21);
    	List col2 = Arrays.asList(2, 7, 12, 17, 22);
    	List col3 = Arrays.asList(3, 8, 13, 18, 23);
    	List col4 = Arrays.asList(4, 9, 14, 19, 24);
    	List col5 = Arrays.asList(5, 10, 15, 20, 25);
    	
    	List cross1 = Arrays.asList(1, 7, 13, 19, 25);
    	List cross2 = Arrays.asList(5, 9, 13, 17, 21);
    	
    	List<List> winning = new ArrayList<List>();
    	winning.add(topRow);
    	winning.add(row2);
    	winning.add(midRow);
    	winning.add(row4);
    	winning.add(botRow);
    	winning.add(col1);
    	winning.add(col2);
    	winning.add(col3);
    	winning.add(col4);
    	winning.add(col5);
    	winning.add(cross1);
    	winning.add(cross2);
    	
    	for(List l : winning) {
    		if(playerPositions.containsAll(l)) {
    			return "SIUUUUUU";
    		} else if(cpuPositions.containsAll(l)) {
    			return "CPU wins! Sorry :(";
    		}
    	}

    	if(playerPositions.size() + cpuPositions.size() == 25) {
    		return "CAT!";
    	}
    	
    	return "";
    }
}
