import java.util.Random;
import java.util.ArrayList;
import java.util.Scanner;
import java.util.Arrays;
import java.util.List;
import java.awt.Toolkit;

public class TicTacToe {

    static ArrayList<Integer> playerPositions = new ArrayList<>();
    static ArrayList<Integer> cpuPositions = new ArrayList<>();

    public static void main(String[] args) {
        char[][] gameBoard = {
            {' ','|',' ','|',' ', '|', ' ', '|', ' '},
            {'-', '+', '-','+', '-', '+', '-', '+', '-'},
            {' ','|',' ','|',' ', '|', ' ', '|', ' '},
            {'-', '+', '-','+', '-', '+', '-', '+', '-'},
            {' ','|',' ','|',' ', '|', ' ', '|', ' '},
            {'-', '+', '-','+', '-', '+', '-', '+', '-'},
            {' ','|',' ','|',' ', '|', ' ', '|', ' '},
            {'-', '+', '-','+', '-', '+', '-', '+', '-'},
            {' ','|',' ','|',' ', '|', ' ', '|', ' '}
        };

        printGameBoard(gameBoard);
        
        Scanner scan = new Scanner(System.in);
        
        while(true) {
            System.out.println("Enter your number to play form (1 - 25 ) or enter 0 to surrender:");
            int playerPos = scan.nextInt();

            if (playerPos == 0) {
                System.out.println("YOU ARE LOSER AND I WON, BITCH");
                break;
            }

            placePiece(gameBoard, playerPos, "player");
            playerPositions.add(playerPos);

            String result = checkWinner();
            if(result.length() > 0) {
                printGameBoard(gameBoard);
                if (result.equals("SIUUUUUU")) {
                    printSiuuuAnimation();
                } else {
                    System.out.println(result);
                }
                break;
            }

            int cpuPos = getSmartCpuMove(gameBoard);

            placePiece(gameBoard, cpuPos, "cpu");
            cpuPositions.add(cpuPos);

            System.out.println("CPU chose position: " + cpuPos);
            printGameBoard(gameBoard);

            result = checkWinner();
            if(result.length() > 0) {
                if (result.equals("SIUUUUUU")) {
                    printSiuuuAnimation();
                } else {
                    System.out.println(result);
                }
                break;
            }
        }
    }

